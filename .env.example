# FinMind API (免費註冊: https://finmindtrade.com/)
FINMIND_TOKEN=your_finmind_token_here

# Telegram Bot (找 @BotFather 建立)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheet
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account JSON (整串壓成一行)
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 推播通道：telegram（預設）/ teams / both
NOTIFY_CHANNEL=telegram
# Teams Workflows webhook（「收到 webhook 要求時張貼在聊天中」，觸發者選 Anyone）
TEAMS_WEBHOOK_URL=
